# Render the four __...__ placeholders after inspecting the target host.
# Install as a NEW conf.d site, never replace nginx.conf or another site's file.
server {
    listen 80;
    server_name __DOMAIN__;
    # Keep HTTP-01 renewal reachable after HTTPS goes live.
    location ^~ /.well-known/acme-challenge/ {
        root /var/www/research-agent-acme;
        default_type text/plain;
    }
    location / { return 308 https://__DOMAIN__$request_uri; }
}

server {
    listen 443 ssl;
    server_name __DOMAIN__;
    ssl_certificate __CERT_FULLCHAIN__;
    ssl_certificate_key __CERT_PRIVATE_KEY__;
    ssl_protocols TLSv1.2 TLSv1.3;

    root /opt/research-agent-platform/current/apps/web/dist;
    index index.html;
    autoindex off;
    # The API accepts at most 14,000,000 bytes for base64 attachment uploads.
    client_max_body_size 14m;
    add_header X-Content-Type-Options nosniff always;
    add_header Cache-Control "no-store" always;
    # Avoid retaining task IDs, request query strings or attachment paths here.
    access_log off;
    error_log /var/log/nginx/research-agent-platform.error.log warn;

    location ~ /\. { return 404; }
    location = /api { return 404; }
    location /api/ {
        # No trailing URI: preserve /api/v1/... exactly.
        proxy_pass http://127.0.0.1:__API_PORT__;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header Origin $http_origin;
        proxy_set_header Connection "";
        proxy_set_header Forwarded "";
        proxy_set_header X-Forwarded-For "";
        proxy_set_header X-Forwarded-Proto "";
        proxy_set_header X-Real-IP "";
        proxy_cache off;
        proxy_no_cache 1;
        proxy_intercept_errors off;
        proxy_next_upstream off;
        proxy_connect_timeout 5s;
        proxy_read_timeout 30s;
        proxy_send_timeout 30s;
        proxy_buffering off;
        proxy_request_buffering off;
    }
    # Current app uses hash routes; unknown paths must not masquerade as the app.
    location / { try_files $uri $uri/ =404; }
}
