# Review resource limits against the actual host before installing this unit.
[Unit]
Description=Research Agent Platform API
After=network.target
StartLimitIntervalSec=60
StartLimitBurst=5

[Service]
Type=exec
User=research-agent
Group=research-agent
WorkingDirectory=/opt/research-agent-platform/current
EnvironmentFile=/etc/research-agent-platform/platform.env
ExecStart=/opt/research-agent-platform/runtime/bin/node apps/api/dist/main.js
Restart=on-failure
RestartSec=5
TimeoutStopSec=30
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
StateDirectory=research-agent-platform
StateDirectoryMode=0700
ReadWritePaths=/var/lib/research-agent-platform
CPUQuota=50%
MemoryMax=256M
TasksMax=128

[Install]
WantedBy=multi-user.target
