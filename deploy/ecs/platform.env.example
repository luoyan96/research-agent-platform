# Replace DOMAIN and PORT after the target host inventory. This file has no keys.
NODE_ENV=production
HOST=127.0.0.1
PORT=4327
APP_ORIGIN=https://research.example.org
DATABASE_PATH=/var/lib/research-agent-platform/data/platform.sqlite
BLOB_ROOT=/var/lib/research-agent-platform/data/blobs
B3_AI_ENABLED=0
DEEPSEEK_MODEL=deepseek-flash
# Provision a separate 32-byte hex key file, readable by research-agent, before enabling AI.
# LAB_CREDENTIAL_KEY_FILE=/etc/research-agent-platform/lab-credentials.key
OPERATOR_ID=ecs_maintainer
CONFIG_REVISION=ecs-pilot-v1
