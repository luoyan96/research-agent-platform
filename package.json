{
  "name": "research-agent-platform",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.21.0",
  "engines": {
    "node": ">=22.19.0"
  },
  "scripts": {
    "build": "pnpm -r build",
    "typecheck": "pnpm -r typecheck",
    "test": "vitest run",
    "check:content": "node scripts/check-content.mjs",
    "ci": "pnpm check:content && pnpm check:operations && pnpm build && pnpm typecheck && node scripts/export-contracts.mjs --check && pnpm test && node scripts/check-b0-process.mjs && pnpm --filter @research-agent/web check:production",
    "demo": "node scripts/demo.mjs",
    "contracts:export": "node scripts/export-contracts.mjs",
    "check:b0": "node scripts/export-contracts.mjs --check && vitest run packages/contracts/tests apps/api/tests && node scripts/check-b0-process.mjs",
    "api:start": "node apps/api/dist/main.js",
    "db:migrate": "node apps/api/dist/manage.js migrate",
    "db:seed": "node apps/api/dist/manage.js seed",
    "db:credentials": "node apps/api/dist/credentials.js",
    "check:b1": "node scripts/export-contracts.mjs --check && vitest run apps/api/tests/collaboration.spec.ts",
    "check:b2b": "node scripts/export-contracts.mjs --check && vitest run apps/api/tests/coordination.spec.ts apps/api/tests/collaboration.spec.ts apps/api/tests/discovery.spec.ts apps/api/tests/foundation.spec.ts",
    "seed:coordination": "node scripts/seed-b2b-demo.mjs",
    "check:b2a": "node scripts/export-contracts.mjs --check && vitest run apps/api/tests/discovery.spec.ts apps/api/tests/collaboration.spec.ts apps/api/tests/foundation.spec.ts",
    "seed:discovery": "node scripts/seed-b2a-demo.mjs",
    "seed:collaboration": "node scripts/seed-b1-demo.mjs",
    "worker:start": "node apps/api/dist/worker.js",
    "check:b3": "node scripts/export-contracts.mjs --check && vitest run apps/api/tests integrations/deepseek-harness/runtime/tests",
    "capability:configure": "node apps/api/dist/capability-config.js",
    "seed:execution": "node scripts/seed-b3-demo.mjs",
    "check:harness-live": "node scripts/check-harness-live.mjs",
    "check:b3-live": "node scripts/check-b3-live.mjs",
    "check:b3-resilience-live": "node scripts/check-b3-resilience-live.mjs",
    "seed:reuse": "node scripts/seed-b4a-demo.mjs",
    "check:b4a": "node scripts/export-contracts.mjs --check && vitest run apps/api/tests integrations/deepseek-harness/runtime/tests",
    "check:b4a-live": "node scripts/check-b4a-live.mjs",
    "pilot:account": "node apps/api/dist/operate.js",
    "pilot:recover": "node apps/api/dist/recover.js",
    "pilot:web": "node scripts/serve-pilot.mjs",
    "check:b5a": "vitest run apps/api/tests integrations/deepseek-harness/runtime/tests",
    "check:b5a-production": "node scripts/check-b5a-production.mjs",
    "check:operations": "node --check scripts/serve-pilot.mjs && node --check scripts/check-b5a-production.mjs"
  },
  "devDependencies": {
    "@types/node": "22.20.0",
    "typescript": "6.0.3",
    "vitest": "4.1.8"
  }
}
